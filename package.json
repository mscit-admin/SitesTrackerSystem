{
  "name": "sites-tracker-system",
  "version": "0.1.0",
  "private": true,
  "description": "GSDN Telecom Sites Tracker — نظام متابعة مواقع الاتصالات",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/extractI18n.js && prisma generate && next build",
    "i18n:extract": "node scripts/extractI18n.js",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seedAdmin.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed && npm run seed:admin",
    "setup": "prisma generate && prisma db push && npm run db:seed && npm run seed:admin"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "^8.5.28",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.10",
    "tsx": "^4.20.3",
    "typescript": "5.5.3"
  }
}
