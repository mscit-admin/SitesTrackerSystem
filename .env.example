# ---------------------------------------------------------------------------
# GSDN Sites Tracker — environment configuration
# Copy this file to `.env` (setup-server.sh does it for you) and adjust.
# ---------------------------------------------------------------------------

# Database connection.
# Default: a local SQLite file — zero setup, perfect for a single server.
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead:
#   1) set provider = "postgresql" in prisma/schema.prisma
#   2) set the URL below and comment out the SQLite line above
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gsdn?schema=public"

# Port the Node app listens on (defaults to 3000).
# setup-server.sh / deploy.sh read this value and start the app on it.
PORT=3000

# When the app runs behind a reverse proxy on a NON-standard port (e.g. HTTPS on
# 8444), Next.js rejects form submissions unless the proxy forwards the host WITH
# the port. Preferred fix is in nginx: `proxy_set_header Host $http_host;`.
# As an alternative/backup, list the public origin(s) here (comma-separated):
# ALLOWED_ORIGINS=161.97.78.116.nip.io:8444
