# ---------------------------------------------------------------------------
# GSDN Sites Tracker — environment configuration
# Copy this file to `.env` (setup-server.sh does it for you) and adjust.
# ---------------------------------------------------------------------------

# Database connection.
# Default: a local SQLite file — zero setup, perfect for a single server.
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead:
#   1) set provider = "postgresql" in prisma/schema.prisma
#   2) set the URL below and comment out the SQLite line above
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gsdn?schema=public"

# Port the app listens on (optional; defaults to 3000).
# PORT=3000
