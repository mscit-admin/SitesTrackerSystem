// GSDN Sites Tracker — Prisma schema
// SQLite for local dev; switch `provider` to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A telecom site tracked across its full lifecycle.
model Site {
  id           String  @id @default(cuid())
  seq          Int?
  siteId       String  @unique
  name         String?
  towerOwner   String?
  ownerSiteId  String?
  latitude     Float?
  longitude    Float?

  existingOrNew String?
  rtOrGf        String?
  towerType     String?
  towerHeight   Float?
  busbarHeight  Float?

  subRegion String?
  region    String?
  scenario  String? // Outdoor / Indoor
  siteType  String? // FN / HUB / Terminal / MFN / Core

  uplinkSite   String?
  backupSite   String?
  belongToFN   String?
  primaryMFN   String?
  secondaryMFN String?

  cabinetFoundationType String?
  cabinetFoundationDims String?
  deliveryBatch         String?

  // Statement of Work flags
  sowTowerErection String?
  sowSiteAdaption  String?
  sowGecolRequired String?
  sowHlcRequired   String?

  // ---- Computed lifecycle summary (filled by seed / on update) ----
  currentPhase  String  @default("DESIGN")
  progressPct   Int     @default(0)
  isOnair       Boolean @default(false)
  isHandedOver  Boolean @default(false)
  overallStatus String  @default("IN_PROGRESS") // NOT_STARTED / IN_PROGRESS / ONAIR / HANDED_OVER / IN_OPERATION / BLOCKED

  // ---- Key denormalised dates for quick listing/sorting ----
  rfSurveyDate  DateTime?
  prDate        DateTime?
  cwPacDate     DateTime?
  cwFacDate     DateTime?
  rfiDate       DateTime?
  teInstallDate DateTime?
  onairDate     DateTime?
  patDate       DateTime?
  omHandoverDate DateTime?

  // ---- Rich detail kept as JSON strings (parsed in the app) ----
  phaseData String? // full grouped lifecycle payload
  cwBoq     String? // civil-works bill of quantities
  teBoq     String? // telecom-equipment specs & solution

  milestones         Milestone[]
  issues             Issue[]
  maintenanceTickets MaintenanceTicket[]
  preventiveTasks    PreventiveMaintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([currentPhase])
  @@index([overallStatus])
}

/// A single lifecycle stage for a site. Uniform across design → handover → O&M.
model Milestone {
  id          Int       @id @default(autoincrement())
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  phaseCode   String // DESIGN, ACQUISITION, CW_PROCUREMENT, ...
  phaseOrder  Int
  status      String    @default("NOT_STARTED") // NOT_STARTED / IN_PROGRESS / DONE / NA / BLOCKED
  plannedDate DateTime?
  actualDate  DateTime?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, phaseCode])
  @@index([phaseCode])
  @@index([status])
}

/// Pending issue / remark attached to a site.
model Issue {
  id        Int      @id @default(autoincrement())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  title     String
  owner     String?
  remark    String?
  status    String   @default("OPEN") // OPEN / CLOSED
  severity  String   @default("MEDIUM")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Project-level risk register entry.
model Risk {
  id             Int       @id @default(autoincrement())
  riskId         String    @unique
  statement      String
  category       String?
  scope          String? // CW / TE / Both
  affectedSites  Int?
  probability    Int?
  impact         Int?
  score          Int?
  level          String? // Critical / High / Medium / Low
  response       String? // Mitigate / Accept / ...
  mitigation     String?
  riskOwner      String?
  actionOwner    String?
  targetDate     DateTime?
  status         String    @default("Open")
  trend          String? // Increasing / Stable / Decreasing
  lastReviewDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([status])
}

/// Corrective maintenance ticket (post-handover O&M phase).
model MaintenanceTicket {
  id          Int       @id @default(autoincrement())
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  title       String
  category    String? // Power / Fiber / RF / MW / Civil / Security / Other
  priority    String    @default("MEDIUM") // LOW / MEDIUM / HIGH / CRITICAL
  status      String    @default("OPEN") // OPEN / IN_PROGRESS / RESOLVED / CLOSED
  description String?
  reportedBy  String?
  assignedTo  String?
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
}

/// Scheduled preventive maintenance task (post-handover O&M phase).
model PreventiveMaintenance {
  id            Int       @id @default(autoincrement())
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId        String
  taskType      String // e.g. Quarterly Inspection, Battery Test, Generator Service
  frequencyDays Int       @default(90)
  lastDoneAt    DateTime?
  nextDueAt     DateTime?
  status        String    @default("SCHEDULED") // SCHEDULED / DUE / OVERDUE / DONE
  assignedTo    String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([nextDueAt])
}

/// System user (roles for the different teams). Auth wired in a later phase.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("VIEWER") // ADMIN / DESIGN / CIVIL / TE / OM / VIEWER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Acquisition — a nominal point defined by the executor (AT Globe).
model NominalPoint {
  id        String  @id @default(cuid())
  ref       String  @unique // reference/code
  name      String?
  latitude  Float?
  longitude Float?
  region    String?
  status    String  @default("OPEN") // OPEN / ACQUIRED / CANCELLED
  notes     String?

  candidates CandidateSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Acquisition — a candidate site (1..3 per nominal point) moving through the
/// four approval gates until acquired and converted into a Site.
model CandidateSite {
  id             String       @id @default(cuid())
  nominalPoint   NominalPoint @relation(fields: [nominalPointId], references: [id], onDelete: Cascade)
  nominalPointId String

  name      String?
  latitude  Float?
  longitude Float?

  // Selection criteria (step 2)
  proximityKm       Float?
  fiberAvailable    String? // Yes / No / Partial
  easeOfProcedures  String? // High / Medium / Low

  // Tower owner (from the fixed list; SECTOR companies are prioritised)
  towerOwner       String? // Almadar / Albounya / Libyana / LTT / Citizen / Other
  towerOwnerDetail String? // required when Other
  ownerType        String? // SECTOR / CITIZEN / OTHER (derived)
  contactPerson    String?
  contactPhone     String?
  address          String?

  // Survey results (step 4.2 / 4.3)
  surveyDate       DateTime?
  towerInfo        String?
  requiredHeights  String?
  proposedEquipment String?
  installationReq  String?

  equipment CandidateEquipment[]

  // Final package / approved data (steps 5-6)
  approvedHeights   String?
  approvedEquipment String?
  finalDocs         String?

  // Workflow
  stage           String    @default("SUBMITTED")
  // SUBMITTED -> APPROVED_CANDIDATE -> SURVEY_REQUESTED -> SURVEY_APPROVED
  // -> SURVEYED -> TECH_APPROVED -> FINAL_APPROVED -> ACQUIRED ; or REJECTED
  candidateApprovedAt DateTime?
  surveyPermittedAt   DateTime?
  techApprovedAt      DateTime?
  finalApprovedAt     DateTime?
  rejectionGate       String?
  rejectionReason     String?

  linkedSiteId String? // Site.id once converted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([nominalPointId])
}

/// Generic key/value app setting (managed from the Settings screen).
model AppSetting {
  key   String @id
  value String
}

/// A request to delete any record — requires phase-manager then project-manager
/// approval before the record is actually removed. Kept as an audit record even
/// after deletion (entityId cleared, label snapshot retained).
model DeletionRequest {
  id         String  @id @default(cuid())
  entityType String  // SITE / NOMINAL_POINT / RISK / MAINTENANCE_TICKET / PREVENTIVE
  entityId   String?
  label      String  // snapshot code/title for display
  sublabel   String? // snapshot secondary text
  reason     String
  status     String  @default("PENDING") // PENDING / PHASE_APPROVED / REJECTED / COMPLETED
  requestedBy String?

  phaseApprovedAt DateTime?
  phaseApprovedBy String?
  pmApprovedAt    DateTime?
  pmApprovedBy    String?
  rejectedStage   String? // PHASE / PM
  rejectedReason  String?
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entityType])
  @@index([entityId])
}

/// Settings catalogue — equipment type (managed from the Settings screen).
model EquipmentType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Settings catalogue — manufacturer (managed from the Settings screen).
model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// An equipment line determined for a candidate (type + manufacturer + qty).
model CandidateEquipment {
  id            String        @id @default(cuid())
  candidate     CandidateSite @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId   String
  equipmentType String
  manufacturer  String?
  quantity      Int           @default(1)
  createdAt     DateTime      @default(now())

  @@index([candidateId])
}
